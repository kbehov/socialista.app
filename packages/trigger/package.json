{
  "name": "@socialista/trigger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Trigger.dev background tasks for Socialista",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "dev:trigger": "trigger dev",
    "deploy:trigger": "trigger deploy"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/refresh-account-token": {
      "types": "./dist/schemas/refresh-account-token.schema.d.ts",
      "import": "./dist/schemas/refresh-account-token.schema.js"
    },
    "./schemas/publish-post": {
      "types": "./dist/schemas/publish-post.schema.d.ts",
      "import": "./dist/schemas/publish-post.schema.js"
    },
    "./schemas/fetch-account-analytics": {
      "types": "./dist/schemas/fetch-account-analytics.schema.d.ts",
      "import": "./dist/schemas/fetch-account-analytics.schema.js"
    },
    "./schemas/analytics-sweep": {
      "types": "./dist/schemas/analytics-sweep.schema.d.ts",
      "import": "./dist/schemas/analytics-sweep.schema.js"
    },
    "./schemas/static-ad": {
      "types": "./dist/schemas/static-ad.schema.d.ts",
      "import": "./dist/schemas/static-ad.schema.js"
    },
    "./task-types": {
      "types": "./dist/task-types.d.ts",
      "import": "./dist/task-types.js"
    }
  },
  "license": "ISC",
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@socialista/ai": "workspace:*",
    "@socialista/db": "workspace:^",
    "@socialista/types": "workspace:^",
    "@trigger.dev/sdk": "^4.5.3",
    "ai": "^7.0.36",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@socialista/eslint-config": "workspace:^",
    "@socialista/typescript-config": "workspace:^",
    "@trigger.dev/build": "^4.5.3",
    "@types/node": "^25.9.3",
    "eslint": "^10.8.0",
    "trigger.dev": "^4.5.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
